\begin{frame}[fragile]\frametitle{Part 2: Probe Arguments (1 of 2)}
  {\Large Combine {\tt-l} with {\tt-v} to list probe arguments} \\
  \bigskip
  (as root) {\bf dtrace \underline{-lv}f {\color{func}vop\_islocked} | awk 'NF==5;/args/,!NF'} \\
  {\small
