\end{frame}

\begin{frame}\frametitle{Part 1: Other DTrace Globals}
  {\Large\center Globals {\bf NOT} displayed by dwatch} (unless asked for) \\
  \bigskip
  {\bf cpu} = active CPU (number) \\
  {\bf id} = probe ID \\
  {\bf tid} = current thread id \\
  {\bf jid} = jail id of current process \\
  \bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip
\end{frame}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% DWATCH: ACTIONS

\begin{frame}\frametitle{Using dwatch}
  \begin{center}
    {\LARGE {\bf Part 2:} Actions and Predicates}
  \end{center}
\end{frame}

\begin{frame}\frametitle{Part 2: Intermediate dwatch Syntax}
  \begin{center}
    {\LARGE\bf dwatch \underline{\em -E "actions"} $<$probe$>$[,...]} \\
    \bigskip
    {\Large -E can be specified multiple times} \\
    \bigskip\bigskip
    {\LARGE\bf dwatch \underline{\em -t "tests"} $<$probe$>$[,...]} \\
    \bigskip
    {\Large -t can be specified multiple times} \\
  \end{center}
  \bigskip\bigskip\bigskip\bigskip\bigskip\bigskip
\end{frame}

\begin{frame}[fragile]\frametitle{Part 2: dwatch Output (1 of 2)}
  {\large\bf dwatch \underline{-E 'printf("pid \%i sig \%i", arg0, arg1)'} {\color{func}kill}} \\
