%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% DTRACE: REVIEW

\begin{frame}\frametitle{DTrace Review}
  {\bf dtrace <probe\_type> "<probe> [/tests/] \{ [actions] \}" ...} \\
  \begin{itemize}
    \item Probe, Tests, \& Actions must be combined into single arg
    \item Default action gives little information
    \item One-liners frustrating for people that cannot edit "D"
  \end{itemize}
  \bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip
\end{frame}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% TALK: TRANSITION

\begin{frame}\frametitle{}
  \begin{center}
    {\Huge\bf dwatch}
  \end{center}
\end{frame}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% DWATCH: INTRO

\begin{frame}\frametitle{On the Topic of dwatch}
  {\Large\bf Overview} \\
  \begin{itemize}
    \item The Mascot
    \item About
    \item What dwatch does different vs well vs poorly
  \end{itemize}
  \bigskip
  {\Large {\bf Using dwatch} (in-depth) - {\bf 3 Parts}} \\
  \begin{itemize}
    \item Part 1 - {\bf Probes}
    \item Part 2 - {\bf Actions and Predicates}
    \item Part 3 - {\bf Profiles}
  \end{itemize}
  \bigskip\bigskip\bigskip\bigskip\bigskip
\end{frame}

\begin{frame}\frametitle{dwatch Mascot}
  \begin{center}
    {\bf ``Peaches''} the dwatch {\bf ponycorn} \\
    \includegraphics[scale=0.215]{graphics/peaches-11.pdf}
  \end{center}
  \bigskip\bigskip\bigskip
\end{frame}

\begin{frame}\frametitle{dwatch Availability}
  {\Large\bf Available in FreeBSD base (/usr/sbin)} \\
  \bigskip
  {\large
    \begin{itemize}
      \item 11.2-RELEASE (11.2-RC1 or later) \\
      \bigskip
      \item 12.0-CURRENT (Jun 1, 2018 or later)
    \end{itemize}
  }
  \bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip
\end{frame}

\begin{frame}\frametitle{About dwatch}
  {\Large
    \begin{itemize}
      \item Powerful DTrace wrapper
      \item {\bf Intelligent} probe point selection
      \item New globals
      \item Default action displays different info
      \item Profiles
      \item sudo(8) integration
    \end{itemize}
  }
  \bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip
\end{frame}

\begin{frame}\frametitle{What dwatch Does Different}
  \begin{center}
    {\Large\bf Parameterization} \\
    of {\em Probe, Predicate, and Action} \\
    \bigskip
    {\Large\bf DTrace} \\
    makes you pass all of them as a {\em single argument} \\
    \bigskip
    {\Large\bf dwatch} \\
    {\em separates} them for improved usage
  \end{center} 
  \bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip
\end{frame}

\begin{frame}\frametitle{What dwatch Does Well}
  {\Large Filtering and {\em regex}}
  \begin{itemize}
    \item process id $\rightarrow$ {\tt -p pid|regex}
    \item user $\rightarrow$ {\tt -u uid|name|regex}
    \item group $\rightarrow$ {\tt -g gid|name|regex}
    \item jail $\rightarrow$ {\tt -j jid|name}
    \item execname $\rightarrow$ {\tt -k [*]name[*]} {\bf or} {\tt -z regex}
    \item anything $\rightarrow$ {\tt -r regex}
  \end{itemize}
  \bigskip
  {\Large Data Sampling} (for example, via {\tt cron})
  \begin{itemize}
    \item by count $\rightarrow$ {\tt -N num}
    \item by timeout $\rightarrow$ {\tt -T duration}
  \end{itemize}
  \bigskip\bigskip\bigskip
\end{frame}

\begin{frame}[fragile]\frametitle{What dwatch Does {\bf Not} Do Well}
  {\bf DTrace Aggregations} require \underline{debug passthrough} (see below) \\
  \bigskip
  {\scriptsize
    \begin{alltt}
    dwatch \underline{-d}E '@[{\color{func}probefunc}]=count()' {\color{prov}syscall} \underline{| dtrace -s /dev/stdin}
    \end{alltt}
  }
  DTrace needs to be foreground to catch Ctrl-C \\
  \bigskip
  and \\
  \bigskip
  {\bf Some features} rely on dwatch being foreground \\
  and thus {\bf may not work} in debug passthrough
  \bigskip\bigskip\bigskip\bigskip\bigskip\bigskip
\end{frame}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% DWATCH: PROBES

\begin{frame}\frametitle{Using dwatch}
  \begin{center}
    {\LARGE {\bf Part 1:} Probes}
  \end{center}
\end{frame}

\begin{frame}\frametitle{Part 1: Basic dwatch Syntax}
  \begin{center}
    {\LARGE\bf dwatch \underline{$<$probe$>$}} \\
    \bigskip
    {\large\em watch a probe} \\
    \bigskip\bigskip
    {\Large\bf dwatch \underline{$<$probe$>$,$<$probe$>$,...}} \\
    \bigskip
    {\large\em watch multiple probes}
  \end{center}
  \bigskip\bigskip\bigskip\bigskip\bigskip\bigskip
\end{frame}

