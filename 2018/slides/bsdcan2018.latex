%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% DTRACE: PREDICATES

\begin{frame}\frametitle{Using DTrace}
  \begin{center}
    {\LARGE {\bf Part 3:} Predicates (aka Test Conditions)}
  \end{center}
\end{frame}

\begin{frame}\frametitle{Part 3: Expert DTrace Syntax}
  \begin{center}
    {\large (as root) {\bf dtrace -n "$<$probe$>$ \underline{\em/ tests /} \{ actions \}"}} \\
    \bigskip
    {\em actions only when you want them} \\
