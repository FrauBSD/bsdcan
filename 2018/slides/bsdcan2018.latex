{\color{tmagenta}INFO} Watching '{\color{prov}syscall}:{\color{mod}freebsd}:{\color{func}execve}:{\color{name}entry}' ...
{\color{tgreen}2018 Jun  4 00:12:22} 604.604 sshd[18434]: -bash
 -+= 01048 0.0 /usr/sbin/sshd
  \textbackslash-+= 18432 0.604 sshd: dteske [priv]
    \textbackslash-+= 18434 604.604 sshd: dteske@pts/1
      \textbackslash-+= 18435 604.604 -bash
{\color{tgreen}2018 Jun  4 00:12:22} 604.604 bash[18436]: uname -s
 -+= 18434 604.604 sshd: dteske@pts/1
  \textbackslash-+= 18435 604.604 -bash
