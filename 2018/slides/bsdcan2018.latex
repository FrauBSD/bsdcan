%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% DWATCH: PROFILES

\begin{frame}\frametitle{Using dwatch}
  \begin{center}
    {\LARGE {\bf Part 3:} Profiles}
  \end{center}
\end{frame}

\begin{frame}\frametitle{Part 3: Advanced dwatch Syntax}
  \begin{center}
    {\LARGE\bf dwatch \underline{\em -X profile}} \\
    \bigskip
    {\Large loads a ``canned'' solution} \\
    \bigskip\bigskip
    {\LARGE\bf dwatch \underline{\em -Q}} \\
    \bigskip
    {\Large list available profiles}
  \end{center}
  \bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip
\end{frame}

\begin{frame}\frametitle{Part 3: dwatch Profiles (1 of 8)}
  {\Large dwatch {\bf Profiles} automate:} \\
  \bigskip
  {\large
    \begin{itemize}
      \item Probe selection
      \item Data collection
      \item Formatting and display
    \end{itemize}
  }
  \bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip
\end{frame}

