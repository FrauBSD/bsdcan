\begin{frame}\frametitle{Brief [15-year] History of DTrace Support}
  \begin{itemize}
    \item Nov 2003 -- Solaris 10 {\bf [DTrace is born]}
    \item Oct 2007 -- Ported to Mac OS X 10.5
    \item Apr 2008 -- dtrace4linux is born
    \item Jan 2009 -- Ported to {\bf \color{darkred} FreeBSD 7.1}
    \item Feb 2010 -- Ported to NetBSD
    \item Dec 2012 -- Ported to Oracle Linux 6
    \item Feb 2018 -- Oracle relicenses DTrace under GPL
  \end{itemize}
  \bigskip\bigskip\bigskip\bigskip\bigskip\bigskip
\end{frame}

\begin{frame}\frametitle{About DTrace}
  \begin{itemize}
    \item Own ``D'' language
    \item Micro virtual machine
    \item Conservative probe point selection
  \end{itemize}
  \bigskip
  \begin{flushright}
    -- Adam Leventhal [\href{http://twitter.com/ahl}{@ahl}], DTrace Co-Creator
    [\href{http://dtrace.org/blogs/ahl/page/11/}{http://dtrace.org/blogs/ahl/page/11/}]
  \end{flushright}
  \bigskip\bigskip\bigskip\bigskip\bigskip\bigskip
\end{frame}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% DTRACE: PROBES

\begin{frame}\frametitle{Using DTrace}
  \begin{center}
    {\LARGE {\bf Part 1:} Probes}
  \end{center}
\end{frame}

\begin{frame}\frametitle{Part 1: Basic DTrace Syntax}
  \begin{center}
    {\LARGE (as root) {\bf dtrace -n \underline{$<$probe$>$}}} \\
    \bigskip
    {\large\em trace a probe} \\
    \bigskip\bigskip
    {\Large (as root) {\bf dtrace -n \underline{$<$probe$>$,$<$probe$>$,...}}} \\
    \bigskip
    {\large\em trace multiple probes}
  \end{center}
  \bigskip\bigskip\bigskip\bigskip\bigskip\bigskip
\end{frame}

\begin{frame}\frametitle{Part 1: What Is a DTrace Probe?}
  \begin{center}
    {\Large \underline{$<$probe$>$} is a {\bf colon-separated string}} \\
    \bigskip
    representing {\em kernel} or {\em userland} points to trace \\
    \bigskip\bigskip
    $<$$probe$$>$ = 4-Tuple = {\large {
        \color{prov} provider
      }:{
        \color{mod} module
      }:{
        \color{func} function
      }:{
        \color{name} name
      }
    } \\
    \bigskip
    Example: {\color{prov} vfs}:{\color{mod} vop}:{\color{func} vop\_create}:{\color{name} entry} \\
    \bigskip
    \includegraphics[scale=0.5]{dot/dtrace_probes.pdf}
  \end{center}
  \bigskip\bigskip\bigskip\bigskip\bigskip
\end{frame}

\begin{frame}[fragile]\frametitle{Part 1: DTrace Output (1 of 5)}
  {\Large (as root) {\bf dtrace -n {\color{prov} vfs}:{\color{mod} vop}:{\color{func} vop\_create}:{\color{name} entry}}} \\
  {\small
    \begin{alltt}
dtrace: description '{\color{prov}vfs}:{\color{mod}vop}:{\color{func}vop_create}:{\color{name}entry}' matched 1 probe
CPU     ID                 {\color{func}FUNCTION}:{\color{name}NAME}
  3  61206              {\color{func}vop_create}:{\color{name}entry}
  4  61206              {\color{func}vop_create}:{\color{name}entry}
  0  61206              {\color{func}vop_create}:{\color{name}entry}
  3  61206              {\color{func}vop_create}:{\color{name}entry}
  2  61206              {\color{func}vop_create}:{\color{name}entry}
  0  61206              {\color{func}vop_create}:{\color{name}entry}
  2  61206              {\color{func}vop_create}:{\color{name}entry}
  2  61206              {\color{func}vop_create}:{\color{name}entry}
  7  61206              {\color{func}vop_create}:{\color{name}entry}
  \vdots    \vdots                      {\color{func}\vdots}      {\color{name}\vdots}
    \end{alltt}
  }
  \bigskip
\end{frame}

\begin{frame}\frametitle{Part 1: DTrace Probes}
  \begin{center}
    {\Large\bf How many probes are there?} \\
    \bigskip
    $<$probe$>$ = {\bf {\color{prov} :}{\color{mod} :}{\color{func} :}{\color{name} :}} or simply {\bf :} \\
    \bigskip
    \includegraphics[scale=0.272]{dot/dtrace_probes_by_prov.pdf}
  \end{center}
  {\footnotesize * On FreeBSD 11.0-RELEASE-p1 with dtraceall.ko loaded} \\
  \bigskip\bigskip\bigskip\bigskip
\end{frame}

\begin{frame}\frametitle{Part 1: DTrace Probe Wildcards}
  {\Large {\color{prov} provider}, {\color{mod} module}, {\color{func} function}, or {\color{name} name} can use:} \\
  \bigskip
  \begin{itemize}
    \item $Blank$ for wildcard \\
      {\color{prov} vfs}{\bf ::}{\color{func} vop\_create}:{\color{name} entry} \\
    \bigskip
    \item {\bf *} for wildcard (requires quoting) \\
      {\color{prov} vfs}:{\color{mod} {\bf *}}:{\color{func} vop\_create}:{\color{name} entry} \\
    \bigskip
    \item {\bf *} for patterns (no regex):
    \begin{itemize}
      \item {\color{prov} vfs}:{\color{mod} vop}:{\color{func} {\bf *}attr}:{\color{name} entry}
      \item {\color{prov} syscall}::{\color{func} read{\bf *}}:{\color{name} entry}
      \item {\color{prov} vfs}::{\color{func} {\bf *}write{\bf *}}:{\color{name} entry}
    \end{itemize}
  \end{itemize}
  \bigskip\bigskip\bigskip
\end{frame}

\begin{frame}[fragile]\frametitle{Part 1: DTrace Output (2 of 5)}
  {\Large (as root) {\bf dtrace -n "{\color{prov} vfs}::{\color{func} *write*}:{\color{name} entry}"}} \\
  {\small
    \begin{alltt}
dtrace: description '{\color{prov}vfs}::{\color{func}*write*}:{\color{name}entry}' matched 4 probes
CPU     ID                 {\color{func}FUNCTION}:{\color{name}NAME}
  2  61268       {\color{func}vop_getwritemount}:{\color{name}entry}
  2  61228               {\color{func}vop_write}:{\color{name}entry}
  4  61328      {\color{func}vop_get_writecount}:{\color{name}entry}
  4  61328      {\color{func}vop_get_writecount}:{\color{name}entry}
  4  61268       {\color{func}vop_getwritemount}:{\color{name}entry}
  4  61268       {\color{func}vop_getwritemount}:{\color{name}entry}
  4  61268       {\color{func}vop_getwritemount}:{\color{name}entry}
  4  61268       {\color{func}vop_getwritemount}:{\color{name}entry}
  4  61268       {\color{func}vop_getwritemount}:{\color{name}entry}
  \vdots    \vdots                  {\color{func}\vdots}          {\color{name}\vdots}
    \end{alltt}
  }
  \bigskip
\end{frame}

\begin{frame}\frametitle{Part 1: DTrace Multi-Probe Examples}
  {\large Selecting multiple {\bf different} probes ...} \\
  \bigskip
  {\bf read(2)} and {\bf write(2)} syscalls
  \begin{itemize}
    \item {\color{prov} syscall}::{\color{func} read}:{\color{name} entry}{\Large ,}{\color{prov} syscall}::{\color{func} write}:{\color{name} entry} \\
      2 probes
  \end{itemize}
  \bigskip
  {\bf vfs} and {\bf syscall} providers
  \begin{itemize}
    \item {\color{prov} vfs}:::{\Large ,}{\color{prov} syscall}::: \\
      2324 probes
  \end{itemize}
  \bigskip\bigskip\bigskip\bigskip\bigskip
\end{frame}

\begin{frame}[fragile]\frametitle{Part 1: DTrace Output (3 of 5)}
  {\LARGE (as root) {\bf dtrace -n {\color{prov} vfs}:::,{\color{prov} syscall}:::}} \\
  {\small
    \begin{alltt}
dtrace: description '{\color{prov}vfs}:::,{\color{prov}syscall}:::' matched 2324 probes
CPU     ID                 {\color{func}FUNCTION}:{\color{name}NAME}
  6  62594                  {\color{func}ioctl}:{\color{name}return}
  4  60917                  {\color{func}lookup}:{\color{name}entry}
  4  61260               {\color{func}vop_lock1}:{\color{name}entry}
  4  61261              {\color{func}vop_lock1}:{\color{name}return}
  6  62593                   {\color{func}ioctl}:{\color{name}entry}
  4  61200            {\color{func}vop_islocked}:{\color{name}entry}
  4  61201           {\color{func}vop_islocked}:{\color{name}return}
  4  61202              {\color{func}vop_lookup}:{\color{name}entry}
  4  61216              {\color{func}vop_access}:{\color{name}entry}
  \vdots    \vdots                     {\color{func}\vdots}       {\color{name}\vdots}
    \end{alltt}
  }
  \bigskip
\end{frame}

\begin{frame}\frametitle{Part 1: Intermediate DTrace Syntax}
  \begin{center}
    {\Large (as root) {\bf dtrace \underline{$<$probe\_type$>$ $<$probe$>$[,...]}}} \\
    \bigskip
    {\large\em more than just -n and 4-tuples} \\
    \bigskip
    {\large\em tracing an entire {\color{prov} provider}, {\color{mod} module}, {\color{func} function}, or {\color{name} name}}
  \end{center}
  \bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip
\end{frame}

\begin{frame}\frametitle{Part 1: How is DTrace Probe Type Used?}
  {\Large\em $<$probe\_type$>$} \\
  \begin{itemize}
    \item {\Large Includes -n}
    \item {\large Must always precede $<$probe$>$}
    \item {\large Allows shorter $<$probe$>$'s (3-tuple and less)}
    \item {\large Applies to all probes}
  \end{itemize}
  \bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip
\end{frame}

\begin{frame}\frametitle{Part 1: DTrace Probe Type}
  {\color{name}-n} {\color{name} name} or 4-tuple ({\color{prov} prov}:{\color{mod} mod}:{\color{func} func}:{\color{name} name})
  \begin{itemize}
    \item {\color{name} -n tick} $\Leftrightarrow$ -n :::{\color{name} tick}
    \item {\color{name} -n} proc:::{\color{name} create},{\color{name} on-cpu} $\Leftrightarrow$ -n proc:::{\color{name} create},:::{\color{name} oncpu}
  \end{itemize}
  {\color{func}-f} {\color{func} function}
  \begin{itemize}
    \item {\color{func} -f log} $\Leftrightarrow$ -n ::{\color{func} log}:
    \item {\color{func} -f} vfs::{\color{func} zap} $\Leftrightarrow$ -n vfs::{\color{func} zap}:
  \end{itemize}
  {\color{mod}-m} {\color{mod} module}
  \begin{itemize}
    \item {\color{mod} -m zfs} $\Leftrightarrow$ -n :{\color{mod} zfs}::
    \item {\color{mod} -m} fbt:{\color{mod} zfs} $\Leftrightarrow$ -n fbt:{\color{mod} zfs}::
  \end{itemize}
  {\color{prov}-P} {\color{prov} provider}
  \begin{itemize}
    \item {\color{prov} -P syscall} $\Leftrightarrow$ -n {\color{prov} syscall}:::
  \end{itemize}
  \bigskip\bigskip\bigskip
\end{frame}

\begin{frame}[fragile]\frametitle{Part 1: DTrace Output (4 of 5)}
  {\LARGE (as root) {\bf dtrace {\color{mod} -m zfs}}} \\
  {\small
    \begin{alltt}
CPU     ID                    {\color{func}FUNCTION}:{\color{name}NAME}
  1  55893       {\color{func}arc_available_memory}:{\color{name}entry}
  1  61357        {\color{func}none}:{\color{name}arc-available_memory}
  1  55894      {\color{func}arc_available_memory}:{\color{name}return}
  1  55889                 {\color{func}arc_adjust}:{\color{name}entry}
  1  55891            {\color{func}arc_adjust_type}:{\color{name}entry}
  1  58175 {\color{func}multilist_get_random_index}:{\color{name}entry}
  1  58352             {\color{func}spa_get_random}:{\color{name}entry}
  1  58353            {\color{func}spa_get_random}:{\color{name}return}
  1  58175 {\color{func}multilist_get_random_index}:{\color{name}entry}
  \vdots    \vdots                {\color{func}\vdots}               {\color{name}\vdots}
    \end{alltt}
  }
  \bigskip\bigskip
\end{frame}

\begin{frame}\frametitle{Part 1: Listing DTrace Probes}
  {\large
    {\Large List all probes ...} \\
    \bigskip
    \begin{itemize}
      \item (as root) {\bf dtrace -ln :}
    \end{itemize}
    \bigskip
    {\Large List matching probes ...} \\
    \bigskip
    \begin{itemize}
      \item (as root) {\bf dtrace -l{\color{prov} P syscall}}
      \item (as root) {\bf dtrace -ln "::{\color{func} exec*}:{\color{name} entry}"}
    \end{itemize}
  }
  \bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip
\end{frame}

\begin{frame}[fragile]\frametitle{Part 1: DTrace Output (5 of 5)}
  {\LARGE (as root) {\bf dtrace -l{\color{prov} P syscall}}} \\
  {\small
    \begin{alltt}
