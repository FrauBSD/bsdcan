\begin{frame}[fragile]\frametitle{Part 1: DTrace Probe ID}
  {\Large \underline{Probe ID} can be used to list probe} \\
  \bigskip
  {\large (as root) {\bf dtrace -li \underline{61200}}} \\
  {\small
    \begin{alltt}
   ID   {\color{prov}PROVIDER}   {\color{mod}MODULE}       {\color{func}FUNCTION} {\color{name}NAME}
\underline{61200}        {\color{prov}vfs}      {\color{mod}vop}   {\color{func}vop_islocked} {\color{name}entry}
    \end{alltt}
  }
  \bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip
\end{frame}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% DTRACE: ACTIONS

\begin{frame}\frametitle{Using DTrace}
  \begin{center}
    {\LARGE {\bf Part 2:} Actions}
  \end{center}
\end{frame}

\begin{frame}\frametitle{Part 2: Advanced DTrace Syntax}
  \begin{center}
    {\Large (as root) {\bf dtrace -n "$<$probe$>$ \underline{\em \{ actions \}}"}} \\
    \bigskip
    {\large\em more than just cpu, id, {\color{func} probefunc}, and {\color{name} probename}} \\
  \end{center}
  \bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip
\end{frame}

\begin{frame}\frametitle{Part 2: DTrace Default Action}
  {\large
    {\Large Default action is to print {\bf 4 globals}}
    \begin{itemize}
      \item {\tt cpu}
      \item {\tt id} [of the probe]
      \item {\tt {\color{func} probefunc}}
      \item {\tt {\color{name} probename}}
    \end{itemize}
    \bigskip
    {\Large Default action with {\bf -F} is to print {\bf 2 globals}}
    \begin{itemize}
      \item {\tt cpu}
      \item {\tt {\color{func} probefunc}}
    \end{itemize}
  }
  \bigskip\bigskip\bigskip\bigskip
\end{frame}

\begin{frame}\frametitle{Part 2: Other DTrace Globals}
  {\Large\center Globals {\bf NOT} displayed by DTrace} (unless asked for) \\
  \bigskip
  {\bf {\color{prov} probeprov}} = DTrace probe provider \\
  {\bf {\color{mod} probemod}} = DTrace probe module \\
  {\bf execname} = executable name of current process \\
  {\bf timestamp} = UNIX epoch in UTC with $\mu$s precision \\
  {\bf walltimestamp} = Traditional UNIX epoch \\
  {\bf pid} = current process id \\
  {\bf uid} = current user id \\
  {\bf gid} = current group id \\
  {\bf jid} = jail id of current process (recently added) \\
  {\bf tid} = current thread id \\
  {\bf curthread} = {\tt struct thread} from /usr/include/sys/proc.h \\
  \bigskip\bigskip\bigskip\bigskip\bigskip\bigskip\bigskip
\end{frame}

\begin{frame}[fragile]\frametitle{Part 2: DTrace Output (1 of 3)}
  (as root) {\bf dtrace -n '{\color{prov}syscall}::: \{ printf("\%s", execname) \}'} \\
  {\small
