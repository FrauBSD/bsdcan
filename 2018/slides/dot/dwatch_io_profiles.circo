/* vim: set filetype=dot :: Vi/ViM */
strict digraph {

	/*
	 * Graph setup and orientation
	 */
	margin = 0; // minimize white border

	/*
	 * Default node attributes
	 */
	node [
		fontname = "Arial",
		fontsize = 16,
		fontcolor = "white",
		shape = box,
		style = "filled",
		colorscheme = "set15",
		penwidth = 0,
	];

	/*
	 * Providers
	 */
	{
		node [ fillcolor = 1 ];
		io;
	};

	/*
	 * Names
	 */
	{
		node [ fillcolor = 4 ];
		"io-done" [ label = "done" ];
		"io-start" [ label = "start" ];
	};

	/*
	 * Relationships
	 */
	io -> "io-done";
	io -> "io-start";
}
